server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- Security headers ---------------------------------------------------
    # Applied at the server level with `always`. The cache locations below use
    # `expires` / `default_type` rather than `add_header`, so they do NOT trip
    # nginx's rule that a block with its own add_header stops inheriting these.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()" always;
    # CSP tuned to what the app actually loads:
    #  - script-src: our bundle + registerSW (self) and Deezer's JSONP endpoint.
    #  - style-src 'unsafe-inline': React style attributes (countdown ring, bars).
    #  - connect-src: Spotify Web API + the PKCE token exchange on accounts.
    #  - img-src i.scdn.co: Spotify album cover art.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://api.deezer.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.scdn.co; font-src 'self'; connect-src 'self' https://api.spotify.com https://accounts.spotify.com; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;

    # --- Optional CORS (opt-in via env var) ---------------------------------
    # The app itself needs no CORS here — it serves same-origin static files, and
    # the browser talks to Spotify/Deezer directly (Deezer has no CORS, hence the
    # app's JSONP). This hook is for *deployers* who want another origin to fetch
    # the served files — e.g. a different site importing this server's public
    # routine JSON. This file is an nginx env-template: the image entrypoint runs
    # envsubst over /etc/nginx/templates/*.template at startup. Set the origin:
    #     -e CORS_ALLOW_ORIGIN=https://app.example.com     (or "*")
    # Empty (the Dockerfile default) => nginx omits the header, so cross-origin
    # reads stay blocked. Covers simple GET/HEAD reads; extend for credentials or
    # custom-header preflight if you need it.
    add_header Access-Control-Allow-Origin "${CORS_ALLOW_ORIGIN}" always;
    add_header Vary "Origin" always;

    # SPA fallback: no router library, and the OAuth redirect lands on /callback,
    # so any unmatched path (incl. /track/:id deep links) must serve index.html
    # and let the React app resolve the route client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The PWA service worker and manifest must never be cached aggressively,
    # otherwise clients get stuck on a stale shell. `expires -1` => no-cache, and
    # avoids add_header so the security headers above still apply.
    location = /sw.js {
        expires -1;
    }

    location = /manifest.webmanifest {
        # nginx's default mime.types has no webmanifest entry; set it explicitly.
        default_type application/manifest+json;
        expires -1;
    }

    # Long-lived caching for fingerprinted build assets.
    location /assets/ {
        expires 1y;
    }

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;
}
