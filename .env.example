# Copy this file to ".env" and fill in your Spotify app's Client ID.
# Create a free app at https://developer.spotify.com/dashboard
# Add these Redirect URIs to the app settings:
#   http://127.0.0.1:5173/callback   (local dev)
#   https://<your-deployed-domain>/callback   (production / iPhone testing)
#
# The Client ID is NOT a secret, but we keep it out of git so each
# environment can use its own app.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional: only used by scripts/spotify-search.mjs (the spotify-search skill)
# to get an app token via the client-credentials flow. NOT used by the web app.
# Dashboard → your app → Settings → "View client secret". Keep it secret.
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
